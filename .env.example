# ==========================================
# ⚙️ KONFIGURASI SERVER & DATABASE
# ==========================================
PORT=5000
NODE_ENV=production

# URL Database MongoDB (Gunakan MongoDB Atlas untuk Vercel agar data persisten)
# Contoh MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/campus_lost_found?retryWrites=true&w=majority
DATABASE_URL=mongodb+srv://<user>:<password>@cluster.mongodb.net/campus_lost_found?retryWrites=true&w=majority

# ==========================================
# ☁️ CLOUDINARY MEDIA STORAGE (Untuk Vercel)
# ==========================================
# Dapatkan gratis di https://cloudinary.com (Dashboard)
# Jika kredensial ini tidak diisi, sistem otomatis menggunakan Base64 storage di MongoDB (0-config fallback)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Atau gunakan satu baris URL Cloudinary:
# CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
